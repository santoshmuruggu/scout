TAVILY_API_KEY=

# Langfuse Cloud (free tier, optional) — sign up at cloud.langfuse.com,
# create a project, copy its keys here
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Model for the cluster/synthesize/critique nodes — pick ONE:
# Option A: Claude (what the live demo and the README eval numbers use)
ANTHROPIC_API_KEY=

# Option B: a local Ollama model (https://ollama.com), no Anthropic key.
# `ollama pull` the model first.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_HOST=http://localhost:11434
